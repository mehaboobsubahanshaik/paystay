# Copy this file to .env and change anything that clashes with other projects on your machine.
# Then: docker compose up --build

# Ports on your computer (the containers keep their own ports inside Docker)
WEB_PORT=8090        # the app:      http://localhost:8090
API_PORT=5090        # API/Swagger:  http://localhost:5090/swagger
DB_PORT=5433         # PostgreSQL:   localhost:5433
PGADMIN_PORT=5050    # pgAdmin:      http://localhost:5050 (docker compose --profile tools up)
VITE_PORT=5173       # only for `npm run dev` (local development)

# Database password (used by the db and api containers)
DB_PASSWORD=paystay

# Secrets and owner login
JWT_KEY=CHANGE-ME-dev-only-key-for-paystay-at-least-32-characters-long
OWNER_MOBILE=9000000001
