# Local development only (npm run dev). Copy to .env to change.
# Port for the Vite dev server
VITE_PORT=5173
# Where the API is running
VITE_API_TARGET=http://localhost:5090
# Leave empty to call the API on the same origin (Vite dev proxy or nginx in Docker).
# Set it only when the built site and the API are on different hosts.
VITE_API_URL=
